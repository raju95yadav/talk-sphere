# Logs
logs
*.log
npm-debug.log*

# Dependency directories
node_modules/
client/node_modules/
server/node_modules/

# Build directories
dist/
client/dist/
client/dist-ssr/

# Environment variables (Sensitive data)
.env
.env.*
.env*.local
*.env
client/.env
client/.env.*
server/.env
server/.env.*

# Preserve sanitized example templates in version control
!.env.example
!client/.env.example
!server/.env.example

# TLS / SSL Certificates & Cryptographic Keys
*.pem
*.key
*.crt
*.cert
*.pfx
*.p12

# OS Metadata
.DS_Store
Thumbs.db

# Load testing runtime dumps & profiling artifacts
load-tests/reports/benchmark_results.json
load-tests/reports/*.html
load-tests/temp/
*.clinic/
