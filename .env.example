# ==============================================================================
# TalkSphere Environment Configuration Template (.env.example)
# Use this template for local development and production deployments.
# DO NOT commit real secrets, private keys, or passwords to version control!
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connections
# MongoDB Connection String (Atlas SRV or standalone)
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<db_cluster>.mongodb.net/talksphere?retryWrites=true&w=majority

# Redis Distributed Cache, Presence & BullMQ Queue Broker
# Format: redis://[:password@]host[:port] or rediss:// (TLS)
REDIS_URL=redis://localhost:6379
REDIS_URI=redis://localhost:6379

# Cryptographic Authentication Secrets
# JWT Secret: Minimum 32-character high-entropy cryptographic random string
JWT_SECRET=replace_with_random_32_character_cryptographic_secret_key

# WebRTC & NAT Traversal (Coturn Media Relay)
TURN_HOST=coturn
TURN_REALM=turn.talksphere.local
# TURN_SHARED_SECRET: Shared secret key for dynamic HMAC-SHA1 ephemeral credentials
TURN_SHARED_SECRET=replace_with_secure_random_coturn_auth_shared_secret

# LiveKit SFU Media Server (Multi-Party WebRTC Video/Audio)
LIVEKIT_URL=wss://livekit.talksphere.com
LIVEKIT_API_KEY=replace_with_livekit_api_key
LIVEKIT_API_SECRET=replace_with_livekit_api_secret_key

# Gemini AI & RAG Embeddings
GEMINI_API_KEY=replace_with_gemini_api_key

